FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /bin/uv

WORKDIR /RAGGraph

ENV UV_PROJECT_ENVIRONMENT=/RAGGraph/.venv \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONPATH=/RAGGraph/src:/RAGGraph \
    PATH=/RAGGraph/.venv/bin:$PATH

COPY pyproject.toml uv.lock ./

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project

COPY raw_docs ./raw_docs
COPY src/api ./src/api
COPY src/app ./src/app
COPY src/config ./src/config
COPY src/utils ./src/utils
COPY params.yaml ./params.yaml

RUN --mount=type=secret,id=openai_api_key \
    OPENAI_API_KEY="$(cat /run/secrets/openai_api_key)" \
    python ./src/app/ingestion.py

FROM python:3.12-slim AS runner
WORKDIR /RAGGraph

COPY --from=builder /RAGGraph /RAGGraph

ENV PYTHONPATH=/RAGGraph/src:/RAGGraph \
    PATH=/RAGGraph/.venv/bin:$PATH

EXPOSE 8000
CMD [ "uvicorn","api.main:app","--host","0.0.0.0","--port","8000" ]